# Copy to .env and fill in. Never commit the real .env.
PORT=3000
# 0.0.0.0 lets other devices on the network reach it (dev). In production use 127.0.0.1
# so only the reverse proxy (Nginx) can reach the app.
HOST=0.0.0.0
# Set to "production" on the server - it then refuses weak/placeholder secrets.
NODE_ENV=development
# Production: 10+ characters.
ADMIN_PASSWORD=change-me
# Production: 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too
# Keep the database OUTSIDE the release folder in production so redeploys never touch it.
DATABASE_PATH=./data/bream-bay.sqlite
# Optional: where `npm run backup` writes (default: a backups/ folder next to the database) and how many to keep.
# BACKUP_DIR=
# BACKUP_KEEP=30
