# Copy to .env (in the app's main folder) and fill in. Never commit the real .env.
PORT=3000
# 0.0.0.0 lets other devices on the network reach it (dev). In production use 127.0.0.1
# so only the web server's proxy can reach the app.
HOST=0.0.0.0
# Set to "production" on the server - it then refuses weak/placeholder passwords.
NODE_ENV=development
# Production: 10+ characters.
ADMIN_PASSWORD=change-me
# Optional. If left out, a random secret is created once and stored in the data folder.
# SESSION_SECRET=
# Optional. Defaults to data/bream-bay.sqlite inside the app folder.
# DATABASE_PATH=
# Optional: how many proxies sit in front of the app (default 1). Behind Cloudflare AND OpenLiteSpeed use 2.
# Open /admin/diagnostics after logging in: if "req.ip" is not your own address, set this and restart.
# TRUST_PROXY=1
# Optional: where `npm run backup` writes (default: data/backups) and how many to keep.
# BACKUP_DIR=
# BACKUP_KEEP=30
