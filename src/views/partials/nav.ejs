<%
// Expects: league, active ('standings' | 'teams' | 'fixtures' | 'bracket' | 'info').
// Which tabs show (and their names/order) is set per league in Admin > Menu.
const items = resolveNavTabs(league, typeof navCounts !== 'undefined' ? navCounts : {});
const icons = {
  standings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>',
  teams: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 14.2c2.6.5 4.5 2.6 4.5 5.3"/></svg>',
  fixtures: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>',
  info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>',
  bracket: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H4v6h4M8 14H4v6h4M8 7h4v10H8"/><path d="M12 12h3a2 2 0 0 0 2-2V7M12 12h3a2 2 0 0 1 2 2v3"/><circle cx="19" cy="6" r="2"/><circle cx="19" cy="18" r="2"/></svg>',
};
%>
<nav class="app-nav no-print">
  <% items.forEach(item => { %>
    <a href="<%= item.href %>" class="<%= active === item.key ? 'active' : '' %>">
      <span class="app-nav-icon"><%- icons[item.key] %></span>
      <span class="app-nav-label"><%= item.label %></span>
    </a>
  <% }) %>
</nav>
