<%
// Expects: standings (array from computeStandings)
// Optional: split - from resolveSplit(league, standings.length): marks the top / bottom halves with labels or a line
// Optional: linkTeams (boolean) - team names link to the team page
const split = typeof splitMarks !== 'undefined' && splitMarks ? splitMarks : { mode: 'off', cuts: [], texts: [] };
%>
<div class="table-scroll">
<table class="standings-table">
  <thead>
    <tr>
      <th>#</th><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>Pts</th>
    </tr>
  </thead>
  <tbody>
    <% standings.forEach((row, i) => { %>
      <% if (split.mode === 'labels' && (i === 0 || split.cuts.includes(i))) { %>
        <tr class="split-label"><td colspan="9"><%= split.texts[i === 0 ? 0 : split.cuts.indexOf(i) + 1] %></td></tr>
      <% } %>
      <tr class="<%= (split.mode === 'line' && split.cuts.includes(i + 1)) ? 'split-row' : '' %>" data-team-id="<%= row.teamId %>">
        <td><%= i + 1 %></td>
        <td>
          <% if (typeof linkTeams !== 'undefined' && linkTeams && typeof league !== 'undefined') { %><a href="/league/<%= league.id %>/team/<%= row.teamId %>"><%= row.name %></a><% } else { %><%= row.name %><% } %>
          <% if (row.tied && !row.tieResolved) { %>
            <span class="tag tag-tie" title="Tied on points and goal difference — needs a shootout to settle">tied</span>
          <% } %>
        </td>
        <td><%= row.played %></td>
        <td><%= row.won %></td>
        <td><%= row.drawn %></td>
        <td><%= row.lost %></td>
        <td><%= row.goalsFor %></td>
        <td><%= row.goalsAgainst %></td>
        <td><strong><%= row.points %></strong></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
