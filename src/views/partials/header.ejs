<!DOCTYPE html>
<html lang="en"<%- typeof league !== 'undefined' && league ? ` data-league-id="${league.id}"` : '' %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Bream Bay Twilight Football</title>

  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="Fixtures, results, standings and Cup/Plate brackets for Bream Bay Twilight Football.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bream Bay Twilight Football">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' — ' : '' %>Bream Bay Twilight Football">
  <meta property="og:description" content="Fixtures, results, standings and Cup/Plate brackets. Add it to your phone's home screen.">
  <meta property="og:url" content="<%= baseUrl %><%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <meta property="og:image" content="<%= baseUrl %>/icons/icon-512.png">
  <meta name="twitter:card" content="summary">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#6e1b2e">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="BB Twilight">

  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <% if (typeof printCss !== 'undefined' && printCss) { %>
    <link rel="stylesheet" href="/css/print.css?v=<%= assetVersion %>" media="all">
  <% } %>
</head>
<body<%- typeof bodyClass !== 'undefined' ? ` class="${bodyClass}"` : '' %>>
<header class="site-header no-print">
  <div class="container">
    <a class="brand" href="/">
      <img src="/img/logo.svg" alt="" width="30" height="35">
      <span>Bream Bay Twilight Football</span>
    </a>
  </div>
</header>
<main class="container">
