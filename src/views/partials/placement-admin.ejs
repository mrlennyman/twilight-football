<%# Expects: league, stageComplete, tieBlocks (main table), cupRounds (the final round, once drawn) %>
<% if (cupRounds.length === 0) { %>
  <% if (stageComplete && tieBlocks.length > 0) { %>
    <p class="muted">Settle the tied teams above first, then the final round can be drawn.</p>
    <button type="button" disabled>Draw the final round</button>
  <% } else if (stageComplete) { %>
    <p class="muted">Every group game has a result. Drawing the final round pairs the table off from the top (1st v 2nd, 3rd v 4th and so on) in one more round straight after the last one, on the same night. Group results are locked once it is drawn.</p>
    <form method="POST" action="/admin/league/<%= league.id %>/generate-final-round">
      <button type="submit">Draw the final round</button>
    </form>
  <% } else { %>
    <p class="muted">Available once every group-stage match has a result.</p>
  <% } %>
<% } else { %>
  <%- include('../partials/round-list', { rounds: cupRounds, editable: true, knockout: true, league }) %>
  <p class="help">A drawn match is fine - a shootout winner can be picked but isn't needed.</p>
  <details class="reset-brackets">
    <summary>Reset the final round (a group score was wrong)</summary>
    <form method="POST" action="/admin/league/<%= league.id %>/knockouts/reset" class="admin-form">
      <p class="callout">This deletes the final round and its results and unlocks the group results so you can correct them. A safety copy of the database is saved first. Then draw the final round again.</p>
      <label>Type the league name (<strong><%= league.name %></strong>) to confirm
        <input type="text" name="confirm_name" autocomplete="off" required>
      </label>
      <button type="submit">Reset the final round</button>
    </form>
  </details>
<% } %>
