<%- include('../partials/header', { title: league.name + (isPlacementFinal(league) ? ' — Final round' : isThreeGroupFinals(league) ? ' — Finals' : ' — Cup / Plate') }) %>
<%- include('../partials/nav', { league, active: 'bracket' }) %>
<%- include('../partials/league-title', { league }) %>

<% if (isPlacementFinal(league)) { %>
  <%- include('../partials/finals-blurb', { collapsible: true, open: placementRounds.length === 0 }) %>
  <% if (placementRounds.length === 0) { %>
    <p>The final round will appear here once the last group game has been played.</p>
  <% } else { %>
    <h2>The final round</h2>
    <%- include('../partials/round-list', { rounds: placementRounds, editable: false, linkTeams: true, league }) %>
    <% if (placings) { %>
      <h2>Final placings</h2>
      <div class="table-scroll">
      <table class="standings-table">
        <thead><tr><th>#</th><th>Team</th></tr></thead>
        <tbody>
          <% placings.forEach(p => { %>
            <tr data-team-id="<%= p.teamId %>"><td><%= p.place %></td><td><a href="/league/<%= league.id %>/team/<%= p.teamId %>"><%= p.name %></a></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  <% } %>
<% } else if (isThreeGroupFinals(league)) { %>
  <%- include('../partials/finals-blurb', { collapsible: true, open: !selectedGroup }) %>
  <% if (!selectedGroup) { %>
    <p>The finals haven't started yet — they'll appear here once the group stage is complete.</p>
  <% } else { %>
    <nav class="week-tabs finals-tabs" aria-label="Finals groups">
      <% finalsGroups.forEach(group => { %>
        <a href="?group=<%= group.stage %>" class="<%= group.stage === selectedGroup.stage ? 'active' : '' %>"><%= group.name %></a>
      <% }) %>
    </nav>
    <h2><%= selectedGroup.name %> <span class="muted small">(places <%= selectedGroup.places[0] %> to <%= selectedGroup.places[1] %>)</span></h2>
    <% if (selectedGroup.rrRounds.length > 0) { %>
      <h3>Round robin</h3>
      <%- include('../partials/standings-table', { standings: selectedGroup.standings, linkTeams: true }) %>
      <%- include('../partials/round-list', { rounds: selectedGroup.rrRounds, editable: false, linkTeams: true }) %>
    <% } %>
    <% if (selectedGroup.koRounds.length > 0) { %>
      <h3>Knockout</h3>
      <%- include('../partials/round-list', { rounds: selectedGroup.koRounds, editable: false, linkTeams: true, league }) %>
    <% } else if (selectedGroup.rrRounds.length > 0) { %>
      <p class="muted">The semi-finals and Grand Final will appear here after the round robin.</p>
    <% } %>
  <% } %>
<% } else { %>
  <%- include('../partials/finals-blurb') %>
  <% if (cupRounds.length === 0 && plateRounds.length === 0) { %>
    <p>The Cup and Plate knockouts haven't started yet — they'll appear here once the group stage is complete.</p>
  <% } else { %>
    <% [{ label: 'Cup', rounds: cupRounds }, { label: 'Plate', rounds: plateRounds }].forEach(bracket => { %>
      <h2><%= bracket.label %></h2>
      <%- include('../partials/round-list', { rounds: bracket.rounds, editable: false, linkTeams: true, league }) %>
    <% }) %>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
