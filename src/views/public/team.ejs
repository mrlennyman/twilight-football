<%- include('../partials/header', { title: team.name + ' — ' + league.name }) %>
<%- include('../partials/nav', { league, active: 'teams' }) %>
<%- include('../partials/league-title', { league }) %>

<section class="team-page" data-team-id="<%= team.id %>">
  <p class="team-back"><a href="/league/<%= league.id %>/teams">&larr; All teams</a></p>
  <h2 class="team-name"><%= team.name %></h2>
  <% if (team.kit_colour) { %><p class="muted">Kit: <%= team.kit_colour %></p><% } %>
  <button type="button" id="follow-team" class="follow-btn" data-team-id="<%= team.id %>" hidden>Follow this team</button>

  <% if (matches.length === 0) { %>
    <p class="muted">No games scheduled yet.</p>
  <% } else { %>
    <div class="match-list">
      <% matches.forEach(m => { %>
        <div class="match-card team-match">
          <div class="team-match-when"><%= formatDate(m.date) %> &middot; <%= m.stage === 'group' ? 'Round ' + m.round_number : (m.stage === 'cup' ? 'Cup ' : 'Plate ') + (m.bracket_slot === 'final' ? 'final' : 'semi-final') %></div>
          <div class="team-match-main">
            <span>vs <a href="/league/<%= league.id %>/team/<%= m.opponent_id %>"><%= m.opponent_name %></a></span>
            <% if (m.status === 'played') { %>
              <span class="score-badge"><%= m.my_score %> - <%= m.their_score %></span>
            <% } else { %>
              <span class="score-badge score-badge-pending">v</span>
            <% } %>
          </div>
          <div class="match-meta">
            <span><%= m.pitch_label || '—' %></span>
            <% if (m.status === 'played') { %><span>&middot; <%= m.result_text %></span><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
