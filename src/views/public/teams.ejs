<%- include('../partials/header', { title: league.name + ' — Teams' }) %>
<h1><%= league.name %></h1>

<nav class="subnav">
  <a href="/league/<%= league.id %>">Standings</a>
  <a href="/league/<%= league.id %>/teams">Teams</a>
  <a href="/league/<%= league.id %>/fixtures">Fixtures</a>
  <a href="/league/<%= league.id %>/bracket">Cup / Plate</a>
</nav>

<h2>Teams</h2>
<div class="team-grid">
  <% teams.forEach(team => { %>
    <div class="team-card">
      <h3><%= team.name %></h3>
      <% if (team.kit_colour) { %><p class="muted">Kit: <%= team.kit_colour %></p><% } %>
      <ul class="roster">
        <% team.players.forEach(player => { %>
          <li><%= player.displayName %></li>
        <% }) %>
        <% if (team.players.length === 0) { %>
          <li class="muted">Roster to be confirmed</li>
        <% } %>
      </ul>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
