<%- include('../partials/header', { title: league.name + ' — Teams' }) %>
<%- include('../partials/nav', { league, active: 'teams' }) %>
<%- include('../partials/league-title', { league }) %>

<h2>Teams</h2>
<div class="team-grid team-grid-public">
  <% teams.forEach(team => { %>
    <div class="team-card" data-team-id="<%= team.id %>">
      <h3><a href="/league/<%= league.id %>/team/<%= team.id %>"><%= team.name %></a></h3>
      <% if (team.kit_colour) { %><p class="muted">Kit: <%= team.kit_colour %></p><% } %>
      <ul class="roster">
        <% team.players.forEach(player => { %>
          <li><%= player.displayName %></li>
        <% }) %>
        <% if (team.players.length === 0) { %>
          <li class="muted">Roster to be confirmed</li>
        <% } %>
      </ul>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
