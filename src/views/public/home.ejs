<%- include('../partials/header', { title: 'Leagues' }) %>
<section class="leagues-home">
<h1>Leagues</h1>

<% if (leagues.length === 0) { %>
  <p>No leagues are running yet — check back soon.</p>
<% } else { %>
  <div class="league-grid">
    <% leagues.forEach(league => { %>
      <a class="league-card" href="/league/<%= league.id %>">
        <span class="league-card-name"><%= league.name %></span>
        <span class="league-card-season"><%= league.season %></span>
        <span class="league-card-foot">
          <span class="tag tag-<%= league.status %>"><%= league.status.replace('_', ' ') %></span>
          <span class="league-card-go" aria-hidden="true">&rsaquo;</span>
        </span>
      </a>
    <% }) %>
  </div>
<% } %>
</section>

<%- include('../partials/footer') %>
