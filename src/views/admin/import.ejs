<%- include('../partials/header', { title: 'Create a league from a CSV' }) %>
<div class="admin-bar">
  <h1>Create a league from a CSV</h1>
  <a href="/admin">&larr; Dashboard</a>
</div>
<p class="muted">One row per player, team name first. Save your spreadsheet as <strong>CSV</strong>, choose the file below (or paste the text), and the whole league is set up: teams, players and kit colours. You can still edit anything afterwards.</p>
<p><a class="btn btn-light btn-sm" href="/admin/import/sample.csv">Download a sample CSV</a> (8 teams, 6 players each) to fill in.</p>

<form method="POST" action="/admin/import" class="admin-form admin-form-wide">
  <label>League name
    <input type="text" name="name" placeholder="e.g. Adults Twilight" maxlength="80" required>
  </label>
  <label>Season
    <input type="text" name="season" placeholder="e.g. Summer 2026/27" maxlength="40" required>
  </label>
  <label>Number of pitches
    <input type="number" name="num_pitches" value="4" min="1" max="16" required>
  </label>
  <label>Rounds per week
    <input type="number" name="rounds_per_week" value="3" min="1" max="20" required>
  </label>
  <label>CSV file
    <input type="file" id="csv-file" accept=".csv,text/csv,text/plain">
  </label>
  <label>...or paste the CSV text here
    <textarea name="csv" id="csv-text" rows="12" maxlength="90000" required placeholder="team,player,kit&#10;Rovers,Jack Brown,Red&#10;Rovers,Sam Lee,&#10;Wanderers,Mia Chen,Blue"></textarea>
  </label>
  <p class="help">
    Columns: <code>team</code>, <code>player</code>, <code>kit</code> (kit colour is optional, and the header row is optional).
    A team with no players yet is fine - leave the player blank. The number of different teams must be even (2-32).
    Players show to parents as first name + last initial.
  </p>
  <button type="submit">Create league</button>
</form>
<script>
  document.getElementById('csv-file').addEventListener('change', function (event) {
    var file = event.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function () { document.getElementById('csv-text').value = String(reader.result); };
    reader.readAsText(file);
  });
</script>

<%- include('../partials/footer') %>
