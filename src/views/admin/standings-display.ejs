<%- include('../partials/header', { title: league.name + ' — Standings display' }) %>
<div class="admin-bar">
  <h1><%= league.name %> — Standings display</h1>
  <a href="/admin">&larr; Dashboard</a>
</div>
<p class="muted">How the public standings table marks the split between the top and bottom of the table (this league has <%= numTeams %> teams). It's only a display choice: it doesn't change who plays in the Cup or Plate.</p>

<% if (saved) { %><p class="callout">Saved. <a class="btn btn-light btn-sm" href="/league/<%= league.id %>" target="_blank">See the public site</a></p><% } %>

<form method="POST" action="/admin/league/<%= league.id %>/standings-display" class="admin-form admin-form-wide">
  <fieldset class="format-choice">
    <legend>Show the split as</legend>
    <label class="check-row"><input type="radio" name="mode" value="labels" <%= settings.mode === 'labels' ? 'checked' : '' %>> A labelled band above each half (e.g. &ldquo;Top 6&rdquo; and &ldquo;Bottom 6&rdquo;)</label>
    <label class="check-row"><input type="radio" name="mode" value="line" <%= settings.mode === 'line' ? 'checked' : '' %>> Just a gold line between the halves, no text</label>
    <label class="check-row"><input type="radio" name="mode" value="off" <%= settings.mode === 'off' ? 'checked' : '' %>> Nothing - a plain table</label>
  </fieldset>

  <label class="check-row"><input type="checkbox" name="three" <%= settings.three ? 'checked' : '' %>> Add a second line (three groups instead of two, e.g. Cup / Plate / Bowl)</label>

  <label>Text above the top group <span class="muted">(blank = &ldquo;Top N&rdquo;)</span>
    <input type="text" name="top" value="<%= settings.top %>" maxlength="30" placeholder="e.g. Cup">
  </label>
  <label>Text above the middle group <span class="muted">(only used with the second line; blank = &ldquo;Middle N&rdquo;)</span>
    <input type="text" name="middle" value="<%= settings.middle %>" maxlength="30" placeholder="e.g. Plate">
  </label>
  <label>Text above the bottom group <span class="muted">(blank = &ldquo;Bottom N&rdquo;)</span>
    <input type="text" name="bottom" value="<%= settings.bottom %>" maxlength="30" placeholder="e.g. Bowl">
  </label>
  <label>First line after place <span class="muted">(blank = automatic: <%= preview.cuts.length ? 'halfway, after ' + preview.cuts[0] : 'this league has no automatic two-group split, so type a number to get one' %><%= previewThirds.cuts.length === 2 ? '; with the second line, thirds, after ' + previewThirds.cuts.join(' and ') : '' %>)</span>
    <input type="number" name="after" value="<%= settings.after || '' %>" min="1" max="<%= numTeams - 1 %>" placeholder="automatic">
  </label>
  <label>Second line after place <span class="muted">(only used with the second line; blank = automatic)</span>
    <input type="number" name="after2" value="<%= settings.after2 || '' %>" min="1" max="<%= numTeams - 1 %>" placeholder="automatic">
  </label>
  <button type="submit">Save</button>
</form>

<%- include('../partials/footer') %>
